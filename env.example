# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Supabase
SUPABASE_URL=https://gxwykvukfglkwhlyjmdf.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Trello (escalation cards)
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token
TRELLO_LIST_ID=your_trello_list_id

# REQUIRED — used to verify the X-Twilio-Signature header on every
# /answer, /gather, /status request, so only genuine Twilio requests
# for your account are accepted. Find it on the Twilio Console
# dashboard (Account Info > Auth Token). Without this set, the app
# rejects all webhook requests with a 500.
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Not required by the current code (Twilio drives the call purely via
# TwiML responses — no outbound Twilio REST calls are made).
# TWILIO_ACCOUNT_SID=
# APP_URL=
